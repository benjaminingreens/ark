sub markdown_to_html {
    my ($md) = @_;
    my @lines = split /\n/, $md;
    my $out = "";
    my $in_ul = 0;
    my $in_ol = 0;
    my $in_p = 0;

    my $close_p = sub { if ($in_p) { $out .= "</p>\n"; $in_p = 0; } };
    my $close_ul = sub { if ($in_ul) { $out .= "</ul>\n"; $in_ul = 0; } };
    my $close_ol = sub { if ($in_ol) { $out .= "</ol>\n"; $in_ol = 0; } };

    for my $line (@lines) {
        $line =~ s/\r$//;

        if ($line =~ /^\s*$/) {
            $close_p->(); $close_ul->(); $close_ol->();
            next;
        }

        if ($line =~ /^(#{1,3})\s+(.+)$/) {
            $close_p->(); $close_ul->(); $close_ol->();
            my $level = length($1);
            $out .= "<h$level>" . inline($2) . "</h$level>\n";
            next;
        }

        if ($line =~ /^\s*[-*]\s+(.+)$/) {
            $close_p->(); $close_ol->();
            if (!$in_ul) { $out .= "<ul>\n"; $in_ul = 1; }
            $out .= "<li>" . inline($1) . "</li>\n";
            next;
        }

        if ($line =~ /^\s*\d+\.\s+(.+)$/) {
            $close_p->(); $close_ul->();
            if (!$in_ol) { $out .= "<ol>\n"; $in_ol = 1; }
            $out .= "<li>" . inline($1) . "</li>\n";
            next;
        }

        if ($line =~ /^>\s?(.*)$/) {
            $close_p->(); $close_ul->(); $close_ol->();
            $out .= "<blockquote>" . inline($1) . "</blockquote>\n";
            next;
        }

        $close_ul->(); $close_ol->();
        if (!$in_p) { $out .= "<p>"; $in_p = 1; }
        else { $out .= "<br>"; }
        $out .= inline($line);
    }

    $close_p->(); $close_ul->(); $close_ol->();
    return $out;
}

sub inline {
    my ($s) = @_;
    $s = html($s);
    $s =~ s/\[([^\]]+)\]\(([^)]+)\)/'<a href="' . html($2) . '">' . html($1) . '<\/a>'/ge;
    $s =~ s/\*\*([^*]+)\*\*/<strong>$1<\/strong>/g;
    $s =~ s/__([^_]+)__/<strong>$1<\/strong>/g;
    $s =~ s/\*([^*]+)\*/<em>$1<\/em>/g;
    $s =~ s/_([^_]+)_/<em>$1<\/em>/g;
    return $s;
}

sub write_file {
    my ($p, $txt) = @_;
    make_path(dirname($p));
    open my $fh, ">:encoding(UTF-8)", $p or die "Cannot write $p: $!\n";
    print $fh $txt;
    close $fh;
}

sub trim {
    my ($s) = @_;
    $s //= "";
    $s =~ s/^\s+|\s+$//g;
    return $s;
}

sub norm_tag {
    my ($s) = @_;
    $s = trim($s // "");
    $s =~ s/^#//;
    $s = lc $s;
    $s =~ s/[^a-z0-9_-]+/-/g;
    $s =~ s/^-+|-+$//g;
    return $s;
}

sub slug {
    my ($s) = @_;
    $s = lc($s // "");
    $s =~ s/[^a-z0-9_-]+/-/g;
    $s =~ s/^-+|-+$//g;
    return substr($s, 0, 120);
}

sub url_escape {
    my ($s) = @_;
    return slug($s);
}

sub html {
    my ($s) = @_;
    $s //= "";
    $s =~ s/&/&amp;/g;
    $s =~ s/</&lt;/g;
    $s =~ s/>/&gt;/g;
    $s =~ s/"/&quot;/g;
    $s =~ s/'/&#39;/g;
    return $s;
}
