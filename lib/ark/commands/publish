#!/usr/bin/env perl
use strict;
use warnings;
use utf8;
use File::Find;
use File::Path qw(make_path remove_tree);
use File::Basename qw(dirname basename);
use Cwd qw(abs_path getcwd);

# ============================================================
# `ark publish` builds a static HTML site under docs/ from note: records:
#   1. read .arkrc's [publish] tag list (required) and defaults.no_publish
#      (an opt-out tag, default "no_publish")
#   2. scan every note record; a note is published once per [publish] tag
#      it carries, unless it also carries the no_publish tag
#   3. render one page per published note (its body run through a small
#      built-in markdown dialect), one index page per tag, and a site
#      index linking the tags that have any notes
#   4. wrap every page in a template -- .ark/publish.html if present,
#      else the built-in default() below -- and write shared CSS once
#
# docs/ is wiped and rebuilt from scratch on every run.
# ============================================================

binmode(STDOUT, ":encoding(UTF-8)");
binmode(STDERR, ":encoding(UTF-8)");

my $DOCS_DIR = "docs";
my $DEBUG = grep { $_ eq "--debug" } @ARGV;

require_ark_core();
our $UNCLAIMED_KEY; # defined in lib/ark/core.pl, set below

my %conf = load_arkrc(".arkrc");
$UNCLAIMED_KEY = resolve_unclaimed_key(%conf);
my @publish_tags = @{ $conf{publish_tags} || [] };
my $no_publish = norm_tag($conf{defaults}{no_publish} // "no_publish");

die "No [publish] tags found in .arkrc\n" unless @publish_tags;

my $template = read_template();
my @notes = scan_notes();
my %selected_by_tag;
my %published_pages;

for my $r (@notes) {
    next if $no_publish ne "" && $r->{tagset}{$no_publish};

    for my $tag (@publish_tags) {
        next unless $r->{tagset}{$tag};
        push @{ $selected_by_tag{$tag} }, $r;
        $published_pages{$r->{path}} = $r;
    }
}

if (-d $DOCS_DIR) {
    remove_tree($DOCS_DIR) or die "Cannot remove $DOCS_DIR: $!\n";
}
make_path($DOCS_DIR);

write_asset_css();

for my $path (sort keys %published_pages) {
    write_note_page($published_pages{$path});
}

for my $tag (@publish_tags) {
    write_tag_home($tag, $selected_by_tag{$tag} || []);
}

write_site_index();

my $note_count = scalar keys %published_pages;
my $tag_count = scalar grep { @{ $selected_by_tag{$_} || [] } } @publish_tags;
print "Published $note_count note(s) across $tag_count tag homepage(s) to $DOCS_DIR/\n";

sub dbg {
    return unless $DEBUG;
    print STDERR "[publish] ", @_, "\n";
}

sub require_ark_core {
    my $cmd_path = abs_path($0) || $0;
    my $self_dir = dirname($cmd_path);

    my @paths = (
        "$self_dir/../core.pl",
        "$ENV{HOME}/.local/lib/ark/core.pl",
        "/usr/local/lib/ark/core.pl",
        "/usr/lib/ark/core.pl",
    );

    for my $path (@paths) {
        next unless defined $path && -f $path;
        require $path;
        return 1;
    }

    die "Could not find core.pl\n";
}

sub read_template {
    my @paths;

    push @paths, $ENV{ARK_PUBLISH_TEMPLATE} if $ENV{ARK_PUBLISH_TEMPLATE};
    push @paths, ".ark/publish.html";

    my $cmd_path = abs_path($0) || $0;
    my $cmd_dir = dirname($cmd_path);

    push @paths, "$cmd_dir/../templates/publish.html";
    push @paths, "$ENV{HOME}/.local/lib/ark/templates/publish.html" if $ENV{HOME};
    push @paths, "/usr/local/lib/ark/templates/publish.html";
    push @paths, "/usr/lib/ark/templates/publish.html";

    for my $p (@paths) {
        next unless defined $p && -f $p;

        open my $fh, "<:encoding(UTF-8)", $p or next;
        local $/;
        my $txt = <$fh>;
        close $fh;

        dbg("template=$p");
        return $txt;
    }

    return default_template();
}

sub default_template {
    return <<'HTML';
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{title}}</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="{{asset_prefix}}assets/publish.css?v={{css_version}}">
</head>
<body>
<main class="content">
<nav class="topbar" id="topbar">{{breadcrumb}}</nav>
{{content}}
</main>
<script>
window.addEventListener("load", function () {
  var bar = document.getElementById("topbar");
  if (bar) {
    bar.scrollLeft = bar.scrollWidth;
  }
});
</script>
</body>
</html>
HTML
}

sub scan_notes {
    my @files;

    for my $base (@{ $conf{bases} }) {
        my $root = "$base/note";
        next unless -d $root;

        find({
            no_chdir => 1,
            wanted => sub {
                my $p = $File::Find::name;
                return unless -f $p;
                return unless $p =~ /\.txt$/;
                return if $p =~ m{/(?:docs|\.git)/};
                push @files, $p;
            },
        }, $root);
    }

    my @notes;

    for my $file (sort @files) {
        open my $fh, "<:encoding(UTF-8)", $file or next;
        local $/;
        my $text = <$fh>;
        close $fh;

        while ($text =~ /((?:^|\n)\s*note\s*:\s*.*?;;)/sg) {
            my $raw = $1;
            my $entry = $raw;

            $entry =~ s/^\s*note\s*:\s*//s;
            $entry =~ s/;;\s*$//s;
            $entry = trim($entry);

            my $meta_raw = "";
            if ($entry =~ s/\{([^{}]*)\}//s) {
                $meta_raw = $1;
            }

            my $body = trim($entry);
            my @meta = parse_meta($meta_raw);
            my @tags = grep { length } map { norm_tag($_->{val}) } grep { $_->{sym} eq "#" } @meta;
            my %tagset = map { $_ => 1 } @tags;
            my $title = note_title($body, \@meta, $file);
            my $rel = rel_path($file);
            my $id = meta_value(\@meta, "&") || meta_value(\@meta, "id/") || $rel;
            my $date = meta_value(\@meta, "~");

            push @notes, {
                path => $rel,
                file => $file,
                raw => $raw,
                body => $body,
                meta => \@meta,
                tags => \@tags,
                tagset => \%tagset,
                title => $title,
                id => $id,
                date => $date,
                out => note_output_path($rel, $id),
            };
        }
    }

    return @notes;
}

sub meta_value {
    my ($meta, $sym) = @_;

    for my $m (@$meta) {
        return $m->{val} if $m->{sym} eq $sym;
    }

    return "";
}

sub note_title {
    my ($body, $meta, $file) = @_;

    my $t = meta_value($meta, "/");
    return clean_title($t) if length trim($t);

    for my $line (split /\n/, $body) {
        $line = trim($line);
        next unless length $line;

        $line =~ s/^#+\s*//;
        return clean_title($line);
    }

    my $base = basename($file);
    $base =~ s/\.txt$//;
    $base =~ s/[-_]+/ /g;

    return clean_title($base || "Untitled");
}

sub clean_title {
    my ($s) = @_;

    $s = trim($s);
    $s =~ s/\s+/ /g;

    return $s || "Untitled";
}

sub rel_path {
    my ($p) = @_;

    $p =~ s{^\./}{};

    my $cwd = getcwd();
    my $abs = abs_path($p);

    if ($abs && index($abs, "$cwd/") == 0) {
        return substr($abs, length($cwd) + 1);
    }

    return $p;
}

sub note_output_path {
    my ($rel, $id) = @_;

    my $stem = $id || $rel;

    $stem =~ s/^&//;
    $stem =~ s/^id\///;
    $stem = slug($stem);
    $stem ||= slug($rel);

    return "notes/$stem.html";
}

sub write_note_page {
    my ($r) = @_;

    my $out = "$DOCS_DIR/$r->{out}";
    make_path(dirname($out));

    my $content = '<article class="note">'
                . markdown_to_html($r->{body})
                . '</article>';

    my $crumb_tag = first_publish_tag($r) || "notes";

    my $breadcrumb = breadcrumb_html(
        ["../index.html", repo_name()],
        ["../" . url_escape($crumb_tag) . "/index.html", $crumb_tag],
        ["../$r->{out}", $r->{title}],
    );

    write_file($out, render_page($r->{title}, $content, "../", $breadcrumb));
}

sub write_tag_home {
    my ($tag, $items) = @_;

    my $dir = "$DOCS_DIR/$tag";
    make_path($dir);

    my @sorted = sort {
        lc($a->{title}) cmp lc($b->{title}) || $a->{path} cmp $b->{path}
    } @$items;

    my $content = '<section class="tag-home">'
                . '<h1>' . html($tag) . '</h1>'
                . '<nav class="link-list">';

    for my $r (@sorted) {
        my $href = "../$r->{out}";
        $content .= '<a href="' . html($href) . '">' . html($r->{title}) . '</a>';
    }

    $content .= '</nav></section>';

    my $breadcrumb = breadcrumb_html(
        ["../index.html", repo_name()],
        ["../" . url_escape($tag) . "/index.html", $tag],
    );

    write_file("$dir/index.html", render_page($tag, $content, "../", $breadcrumb));
}

sub write_site_index {
    my $repo = repo_name();

    my $content = '<section class="site-home">'
                . '<h1>' . html($repo) . '</h1>'
                . '<nav class="link-list">';

    for my $tag (@publish_tags) {
        my $count = scalar @{ $selected_by_tag{$tag} || [] };
        next unless $count;

        $content .= '<a href="' . html(url_escape($tag)) . '/index.html">'
                 . html($tag)
                 . ' <span class="count">'
                 . $count
                 . '</span></a>';
    }

    $content .= '</nav></section>';

    my $breadcrumb = breadcrumb_html(
        ["index.html", $repo],
        ["index.html", "select a tag..."],
    );

    write_file("$DOCS_DIR/index.html", render_page($repo, $content, "", $breadcrumb));
}

sub render_page {
    my ($title, $content, $asset_prefix, $breadcrumb) = @_;

    $breadcrumb //= breadcrumb_html(["index.html", repo_name()]);

    my $html = $template;
    my $css_version = time();

    $html =~ s/\{\{title\}\}/html($title)/ge;
    $html =~ s/\{\{content\}\}/$content/g;
    $html =~ s/\{\{asset_prefix\}\}/$asset_prefix/g;
    $html =~ s/\{\{breadcrumb\}\}/$breadcrumb/g;
    $html =~ s/\{\{css_version\}\}/$css_version/g;

    return $html;
}

sub write_asset_css {
    make_path("$DOCS_DIR/assets");
    write_file("$DOCS_DIR/assets/publish.css", default_css());
}

